<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ailo.ViewModels"
             xmlns:mcp="using:Ailo.AI.Mcp"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Ailo.Views.Settings.McpSettingsView"
             x:DataType="vm:McpSettingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary-button" Command="{Binding AddMcpServerCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[New]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary-button"
                        Command="{Binding DeleteMcpServerCommand}"
                        CommandParameter="{Binding SelectedServer}"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[Delete]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary-button" Command="{Binding SaveMcpServerCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[Save]}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Localization[McpSettings]}" FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="14">
            <Border Classes="card">
                <ListBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                         Background="Transparent">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:McpServerItem">
                        <Border Classes="settings-list-divider" Margin="0" BorderBrush="{DynamicResource SettingsListDividerBrush}">
                            <Grid ColumnDefinitions="*,Auto" Margin="4" MinHeight="52" HorizontalAlignment="Stretch" ColumnSpacing="4">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Transport}" FontSize="11" Opacity="0.65"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding ServerName}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Localization[McpSettingsDescription]}" Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Localization[McpServerName]}" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ServerName, Mode=TwoWay}"/>
                        <CheckBox Content="{Binding Localization[McpEnabled]}" IsChecked="{Binding ServerEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding Localization[McpTransport]}" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding TransportKinds}" SelectedItem="{Binding Transport, Mode=TwoWay}"
                                  Width="220" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Localization[McpEndpoint]}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsHttpTransport}"/>
                        <TextBox Text="{Binding Endpoint, Mode=TwoWay}" PlaceholderText="https://example.com/mcp"
                                 IsVisible="{Binding IsHttpTransport}"/>
                        <TextBlock Text="{Binding Localization[McpCommand]}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsStdioTransport}"/>
                        <TextBox Text="{Binding Command, Mode=TwoWay}" PlaceholderText="npx / dotnet / python"
                                 IsVisible="{Binding IsStdioTransport}"/>
                        <TextBlock Text="{Binding Localization[McpArguments]}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsStdioTransport}"/>
                        <TextBox Text="{Binding ArgumentsJson, Mode=TwoWay}" AcceptsReturn="True" MinHeight="44"
                                 IsVisible="{Binding IsStdioTransport}"/>
                        <TextBlock Text="{Binding Localization[McpEnvironment]}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsStdioTransport}"/>
                        <TextBox Text="{Binding EnvironmentJson, Mode=TwoWay}" AcceptsReturn="True" MinHeight="44"
                                 IsVisible="{Binding IsStdioTransport}"/>
                        <TextBlock Text="{Binding Localization[McpHeaders]}" FontWeight="SemiBold"
                                   IsVisible="{Binding IsHttpTransport}"/>
                        <TextBox Text="{Binding HeadersJson, Mode=TwoWay}" AcceptsReturn="True" MinHeight="44"
                                 IsVisible="{Binding IsHttpTransport}"/>

                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Classes="transparent-button" Command="{Binding RefreshMcpToolsCommand}" IsEnabled="{Binding !IsRefreshing}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15"/>
                                        <TextBlock Text="{Binding Localization[RefreshMcpTools]}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Localization[McpTools]}" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:McpToolItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" Opacity="0.65" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
