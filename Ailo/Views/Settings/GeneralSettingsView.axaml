<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ailo.ViewModels"
             x:Class="Ailo.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.accent-color-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="0,0,8,0">
        <TextBlock Text="{Binding Localization[GeneralSettings]}" FontSize="22" FontWeight="Bold"/>
        <Border Classes="card" Padding="14">
            <DockPanel>
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel>
                    <TextBlock Text="{Binding Localization[Theme]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localization[ThemeDescriptionShort]}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

            </DockPanel>
        </Border>
        <Border Classes="card" Padding="14">
            <StackPanel Spacing="12">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[AccentColor]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localization[AccentColorDescription]}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding AccentColorOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="44" ItemHeight="44"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccentColorOption">
                                <Button Classes="accent-color-option"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectAccentColorCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="4"
                                        ToolTip.Tip="{Binding DisplayName}">
                                    <Grid Width="34" Height="34">
                                        <Border Width="30" Height="30" CornerRadius="{DynamicResource CornerRadiusRound}"
                                                Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource InputControlBorderBrush}"
                                                BorderThickness="1"/>
                                        <Border IsVisible="{Binding IsSelected}"
                                                CornerRadius="{DynamicResource CornerRadiusRound}"
                                                BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
                                                BorderThickness="2"/>
                                        <Border IsVisible="{Binding IsSelected}"
                                                Width="14" Height="14"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{DynamicResource SystemControlHighlightAltAccentBrush}"
                                                CornerRadius="{DynamicResource CornerRadiusSmall}">
                                            <TextBlock Text="✓" FontSize="10" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Classes="card" Padding="14">
            <DockPanel LastChildFill="True">
                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel>
                    <TextBlock Text="{Binding Localization[Language]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localization[LanguageDescription]}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>

            </DockPanel>
        </Border>
        <Border Classes="card" Padding="14">
            <DockPanel LastChildFill="True">
                <ToggleSwitch DockPanel.Dock="Right"
                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                              OnContent="✓"
                              OffContent=""/>
                <StackPanel>
                    <TextBlock Text="{Binding Localization[Startup]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localization[StartupDescription]}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Classes="card" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel>
                    <TextBlock Text="{Binding Localization[DataDirectory]}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Localization[DataDirectoryDescription]}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <DockPanel HorizontalSpacing="8">
                    <Button DockPanel.Dock="Right" Content="{Binding Localization[Browse]}"
                            Command="{Binding BrowseDataDirectoryCommand}"/>
                    <TextBox Text="{Binding DataDirectory, Mode=TwoWay}"
                             PlaceholderText="{Binding Localization[DataDirectoryPlaceholder]}"/>
                </DockPanel>
                <ToggleSwitch IsChecked="{Binding MigrateData, Mode=TwoWay}"
                              Content="{Binding Localization[MigrateData]}"/>
                <TextBlock Text="{Binding Localization[MigrateDataDescription]}" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap"/>
                <Button HorizontalAlignment="Right" Content="{Binding Localization[ApplyDataDirectory]}"
                        Command="{Binding ApplyDataDirectoryCommand}"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
    </StackPanel>
    </ScrollViewer>
</UserControl>
