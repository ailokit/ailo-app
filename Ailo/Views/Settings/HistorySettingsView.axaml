<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ailo.ViewModels"
             xmlns:local="using:Ailo.Views"
             x:Class="Ailo.Views.Settings.HistorySettingsView"
             x:DataType="vm:HistorySettingsViewModel"
             DataContextChanged="OnDataContextChanged">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary-button" Command="{Binding DeleteHistoryConversationCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Localization[Delete]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary-button" Command="{Binding StartHistoryConversationCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Localization[StartConversation]}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Localization[History]}" FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="14">
            <Border Classes="card">
                <ScrollViewer x:Name="HistoryScrollViewer" ScrollChanged="OnHistoryScrollChanged">
                    <ListBox ItemsSource="{Binding HistoryConversations}"
                             SelectedItem="{Binding SelectedHistoryConversation, Mode=TwoWay}"
                             Background="Transparent">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="settings-list-divider" Margin="0" BorderBrush="{DynamicResource SettingsListDividerBrush}">
                                    <StackPanel Margin="4" Spacing="3">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DisplayUpdatedAt}" FontSize="11" Opacity="0.65"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="14">
                <local:ConversationMessagesView ItemsSource="{Binding HistoryMessages}"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Opacity="0.7" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
