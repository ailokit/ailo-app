<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ailo.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Ailo.Views.Settings.SkillSettingsView"
             x:DataType="vm:SkillSettingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary-button" Command="{Binding AddSkillCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[New]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary-button"
                        Command="{Binding DeleteSkillCommand}"
                        CommandParameter="{Binding SelectedSkill}"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[Delete]}"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary-button" Command="{Binding SaveSkillCommand}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                        <TextBlock Text="{Binding Localization[Save]}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Localization[SkillManagement]}" FontSize="22" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="14">
            <Border Classes="card">
                <ListBox x:Name="SkillList"
                         ItemsSource="{Binding Skills}"
                         SelectedItem="{Binding SelectedSkill}"
                         Background="Transparent"
                         DragDrop.DragOver="OnSkillDragOver"
                         DragDrop.Drop="OnSkillDrop">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="settings-list-divider" Margin="0" BorderBrush="{DynamicResource SettingsListDividerBrush}">
                            <Grid Margin="4" MinHeight="52" HorizontalAlignment="Stretch" Background="Transparent">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBox Text="{Binding SkillName}" PlaceholderText="{Binding Localization[SkillNamePlaceholder]}"/>
                        <TextBox Text="{Binding SkillPrompt}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="240" VerticalContentAlignment="Top"
                                 PlaceholderText="{Binding Localization[SkillPromptPlaceholder]}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <Canvas x:Name="DragOverlay" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="100">
            <Border x:Name="DragPreview"
                    IsVisible="False"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusCompact}"
                    Padding="10,7"
                    MaxWidth="220"
                    Opacity="0.96">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DragPreviewName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DragPreviewDescription"
                               FontSize="11"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               Opacity="0.75"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
