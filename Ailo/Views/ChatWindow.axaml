<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ailo.ViewModels"
        xmlns:local="using:Ailo.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:skills="clr-namespace:Ailo.AI.Skills"
        xmlns:conversations="clr-namespace:Ailo.AI.Conversations"
        xmlns:providers="clr-namespace:Ailo.AI.Providers"
        x:Class="Ailo.Views.ChatWindow"
        x:ClassModifier="internal"
        KeyDown="OnWindowKeyDown"
        x:DataType="vm:ChatWindowViewModel"
        Icon="/Assets/ailo.ico"
        Title="{Binding Localization[AppTitle]}" Width="520" Height="700" MinWidth="420" MinHeight="500"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnWorkspaceDragOver"
        DragDrop.Drop="OnWorkspaceDrop">
    <Grid x:Name="WindowLayout" RowDefinitions="28,*">
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
                <StackPanel x:Name="TitleContent"
                            Orientation="Horizontal"
                            Margin="8,0,0,0"
                            Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization[AppTitle]}"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Classes="window-action-button"
                                  WindowDecorationProperties.ElementRole="User"
                                  IsChecked="{Binding $parent[Window].Topmost, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.Name="{Binding Localization[AlwaysOnTop]}"
                                  AutomationProperties.AutomationId="AlwaysOnTopButton">
                        <materialIcons:MaterialIcon Kind="PinOutline" Width="16" Height="16" />
                    </ToggleButton>
                    <Button Classes="window-action-button"
                            WindowDecorationProperties.ElementRole="User"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{Binding Localization[Settings]}"
                            AutomationProperties.Name="{Binding Localization[Settings]}">
                        <materialIcons:MaterialIcon Kind="Settings" Width="16" Height="16" />
                    </Button>
                    <StackPanel x:Name="CustomWindowButtons" Orientation="Horizontal">
                        <Button Classes="window-action-button" WindowDecorationProperties.ElementRole="MinimizeButton"
                                Click="OnMinimizeWindow" ToolTip.Tip="Minimize">
                            <materialIcons:MaterialIcon Kind="WindowMinimize" Width="16" Height="16" />
                        </Button>
                        <Button Classes="window-action-button" WindowDecorationProperties.ElementRole="MaximizeButton"
                                Click="OnToggleMaximizeWindow" ToolTip.Tip="Maximize">
                            <materialIcons:MaterialIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="16"
                                                        Height="16" />
                        </Button>
                        <Button Classes="window-action-button close-button"
                                WindowDecorationProperties.ElementRole="CloseButton" Click="OnCloseWindow"
                                ToolTip.Tip="Close">
                            <materialIcons:MaterialIcon Kind="WindowClose" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="1" Margin="10,2,10,10" LastChildFill="True" VerticalSpacing="8">
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" HorizontalSpacing="4">
                <Button Classes="model-selector-button" HorizontalAlignment="Left" Padding="0" Margin="0"
                        Height="32" VerticalContentAlignment="Stretch" DockPanel.Dock="Left">
                    <Button.Content>
                        <Border BorderBrush="{DynamicResource InputControlBorderBrush}"
                                BorderThickness="1" Padding="8,2" CornerRadius="{DynamicResource CornerRadiusInput}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding SelectedProviderDisplayName}" FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedModelDisplayName}" FontSize="10" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout
                            Placement="BottomEdgeAlignedLeft"
                            ItemsSource="{Binding AppState.Providers}">
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem"
                                              BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="providers:ApiProvider">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="ItemsSource">
                                        <Setter.Value>
                                            <MultiBinding
                                                Converter="{x:Static vm:AiProviderMenuDataConverter.Instance}">
                                                <Binding Path=""></Binding>
                                                <Binding Path="$parent[Window].DataContext"></Binding>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ItemContainerTheme">
                                        <ControlTheme TargetType="MenuItem"
                                                      BasedOn="{StaticResource {x:Type MenuItem}}"
                                                      x:DataType="vm:ModelMenuItem">
                                            <Setter Property="Header" Value="{Binding ModelId}" />
                                            <Setter Property="Command" Value="{Binding SelectCommand}" />
                                        </ControlTheme>
                                    </Setter>
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="primary-button" DockPanel.Dock="Right" Command="{Binding NewConversationCommand}"
                        Height="32"
                        ToolTip.Tip="{Binding Localization[NewConversation]}"
                        AutomationProperties.Name="{Binding Localization[NewConversation]}" Padding="8">
                    <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                </Button>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding  AppState.Conversations}"
                          SelectedItem="{Binding SelectedConversation}"
                          VerticalAlignment="Center"
                          PlaceholderText="{Binding Localization[HistoryPlaceholder]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="conversations:Conversation">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" HorizontalSpacing="4">
                <ComboBox DockPanel.Dock="Left" Height="32" ItemsSource="{Binding AppState.Skills}"
                          SelectedItem="{Binding SelectedSkill}"
                          PlaceholderText="{Binding Localization[SkillPlaceholder]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="skills:Skill">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button DockPanel.Dock="Left" Classes="transparent-button" Width="32" Height="32" Padding="0"
                        Command="{Binding AddFilesCommand}"
                        IsVisible="{Binding ShowAddAttachmentButton}"
                        ToolTip.Tip="{Binding Localization[AddImage]}"
                        AutomationProperties.Name="{Binding Localization[AddImage]}">
                    <materialIcons:MaterialIcon Kind="FileImage" Width="18" Height="18" />
                </Button>
                <Button DockPanel.Dock="Left" Classes="transparent-button" Width="32" Height="32" Padding="0"
                        ToolTip.Tip="{Binding Localization[SelectWorkspace]}"
                        AutomationProperties.Name="{Binding Localization[SelectWorkspace]}">
                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                    <Button.Flyout>
                        <MenuFlyout  Placement="TopEdgeAlignedLeft">
                            <MenuItem Header="{Binding Localization[SelectWorkspaceFiles]}"
                                      Command="{Binding AddWorkspaceFilesCommand}" />
                            <MenuItem Header="{Binding Localization[SelectWorkspaceFolders]}"
                                      Command="{Binding AddWorkspaceFoldersCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button DockPanel.Dock="Left" Classes="transparent-button" Width="32" Height="32" Padding="0"
                        IsEnabled="{Binding HasSessionTools}"
                        ToolTip.Tip="{Binding Localization[Tools]}"
                        AutomationProperties.Name="{Binding Localization[Tools]}">
                    <materialIcons:MaterialIcon Kind="WrenchOutline" Width="18" Height="18" />
                    <Button.Flyout>
                        <!-- A regular Flyout keeps its content open while checkboxes are toggled. -->
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Localization[Tools]}"
                                           FontWeight="SemiBold" Margin="2,0,0,2" />
                                <ItemsControl ItemsSource="{Binding SessionTools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionToolSelection">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding DisplayName}"
                                                      ToolTip.Tip="{Binding Description}"
                                                      Padding="4,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <ItemsControl DockPanel.Dock="Right"
                              ItemsSource="{Binding WorkspaceEntries}"
                              IsVisible="{Binding HasWorkspaceEntries}"
                              MaxWidth="280"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Right"
                              ToolTip.Tip="{Binding Localization[SelectWorkspace]}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceEntryViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="7,4" Margin="0,0,6,0"
                                    ToolTip.Tip="{Binding Path}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Classes="transparent-button" Padding="0"
                                            Command="{Binding $parent[Window].DataContext.OpenWorkspaceEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[OpenWorkspaceEntry]}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsDirectory}" />
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsFile}" />
                                            <TextBlock Text="{Binding DisplayName}" MaxWidth="120"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="transparent-button" Padding="1"
                                            Command="{Binding $parent[Window].DataContext.RemoveWorkspaceEntryCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[RemoveWorkspaceEntry]}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="6">
                <ItemsControl ItemsSource="{Binding Attachments}"
                              IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="{DynamicResource CornerRadiusSmall}" Padding="4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="transparent-button" Padding="0" Click="OnOpenDraftAttachmentImage"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[ViewImage]}"
                                            AutomationProperties.Name="{Binding $parent[Window].DataContext.Localization[ViewImage]}">
                                        <Image
                                            Source="{Binding FilePath, Converter={x:Static local:ImagePathToBitmapConverter.Instance}}"
                                            Width="40" Height="40" Stretch="UniformToFill" />
                                    </Button>
                                    <Button Classes="transparent-button" Padding="2" VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].DataContext.RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding $parent[Window].DataContext.Localization[RemoveAttachment]}">
                                        <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="DraftTextBox" Text="{Binding Draft, Mode=OneWay}"
                             TextChanged="OnDraftTextChanged"
                             PlaceholderText="{Binding Localization[InputPlaceholder]}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Center"
                             Padding="8,2" MinHeight="32"
                             CaretBrush="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <Button Classes="primary-button" Grid.Column="1" Command="{Binding SendOrStopCommand}"
                            ToolTip.Tip="{Binding SendButtonText}" AutomationProperties.Name="{Binding SendButtonText}"
                            Padding="10,8" MinWidth="42">
                        <Button.Content>
                            <materialIcons:MaterialIcon Kind="{Binding SendButtonIcon}" Width="18" Height="18" />
                        </Button.Content>
                    </Button>
                </Grid>
            </StackPanel>
            <Border Classes="card" Grid.Row="3" Padding="12">
                <local:ConversationMessagesView ItemsSource="{Binding Messages}" />
            </Border>
        </DockPanel>
        <!-- Native non-client hit targets keep the borderless window resizable. -->
        <Border Grid.RowSpan="2" Height="6" VerticalAlignment="Top" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeN" />
        <Border Grid.RowSpan="2" Height="6" VerticalAlignment="Bottom" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeS" />
        <Border Grid.RowSpan="2" Width="6" HorizontalAlignment="Left" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeW" />
        <Border Grid.RowSpan="2" Width="6" HorizontalAlignment="Right" Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeE" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeNW" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeNE" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeSW" />
        <Border Grid.RowSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>
</Window>
