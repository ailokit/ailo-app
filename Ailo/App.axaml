<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:fluent="clr-namespace:Avalonia.Themes.Fluent;assembly=Avalonia.Themes.Fluent"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:markdown="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Ailo.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/ailo-tray.png"
                      mac:MacOSProperties.IsTemplateIcon="True">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Click="OnTrayShowChat" />
                        <NativeMenuItem Click="OnTrayShowSettings" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="OnTrayExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <fluent:ColorPaletteResources x:Key="Light" />
                <fluent:ColorPaletteResources x:Key="Dark" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
        <Style Selector="markdown|CodeBlock">
            <Setter Property="ColorTheme" Value="VisualStudioLight" />
        </Style>
        <Style Selector="markdown|CodeBlock:dark">
            <Setter Property="ColorTheme" Value="VisualStudioDark" />
        </Style>
        <!-- Shared modern surface language layered on top of Fluent. -->
        <Style Selector=":is(Button)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusButton}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button) /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusButton}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button) TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button) materialIcons|MaterialIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).primary-button">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
        </Style>
        <Style Selector=":is(Button).primary-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
        </Style>
        <Style Selector=":is(Button).primary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).primary-button:pressed">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Button).model-selector-button">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Button).model-selector-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
        </Style>
        <Style Selector=":is(Button).model-selector-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).transparent-button /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector=":is(TextBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(TextBox):focus">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector=":is(ComboBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
        </Style>
        <Style Selector="ComboBox /template/ Border#HighlightBackground">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusInput}" />
        </Style>
        <!-- ComboBox's popup is hosted in a separate visual tree, so its named border
             must be targeted directly instead of through the ComboBox ancestor. -->
        <Style Selector="Border#PopupBorder">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ComboBoxItem /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector=":is(ListBox)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusControl}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputControlBorderBrush}" />
        </Style>
        <Style Selector=":is(ListBoxItem)">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector=":is(ListBoxItem):pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(ListBoxItem):selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAltAccentBrush}" />
        </Style>
        <Style Selector="Border.settings-list-divider">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector=":is(ListBoxItem):selected Border.settings-list-divider">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Fluent menus use their own presenter, so apply the shared corner radius directly. -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="MenuFlyoutPresenter /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <!-- MenuItem submenus use their own popup border instead of a
             MenuFlyoutPresenter, so style that nested surface separately. -->
        <Style Selector="MenuItem /template/ Popup#PART_Popup Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="ContextMenu">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="ContextMenu /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="FlyoutPresenter /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="MenuItem /template/ Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).transparent-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).transparent-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).window-action-button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector=":is(Button).window-action-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
        </Style>
        <Style Selector=":is(Button).window-action-button.close-button:pointerover">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
            <Setter Property="BoxShadow" Value="0 4 18 0 #1C000000" />
        </Style>
        <Style Selector="Border.settings-navigation-menu">
            <Setter Property="Background" Value="{DynamicResource SettingsNavigationBackgroundColor}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCompact}" />
            <Setter Property="BoxShadow" Value="0 4 18 0 #30000000" />
        </Style>
        <Style Selector="Border.chat-bubble">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusCard}" />
            <Setter Property="BoxShadow" Value="0 2 12 0 #14000000" />
        </Style>
        <Style Selector="Border.chat-bubble-user">
            <Setter Property="Background" Value="{DynamicResource SecondaryCardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style Selector="Border.chat-bubble-assistant">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        </Style>
        <Style Selector="Border.thinking-header">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThinkingHeaderForegroundColor}" />
        </Style>
        <Style Selector="Border.thinking-header TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingHeaderForegroundColor}" />
        </Style>
        <Style Selector="Border.thinking-content">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <Style Selector="Border.thinking-content TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.thinking-content markdown|MarkdownTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThinkingContentForegroundColor}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Shared corner-radius scale. -->
            <CornerRadius x:Key="CornerRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="CornerRadiusCompact">8</CornerRadius>
            <CornerRadius x:Key="CornerRadiusItem">9</CornerRadius>
            <CornerRadius x:Key="CornerRadiusButton">10</CornerRadius>
            <CornerRadius x:Key="CornerRadiusInput">11</CornerRadius>
            <CornerRadius x:Key="CornerRadiusControl">12</CornerRadius>
            <!-- Fluent's MenuItem submenu border binds directly to this resource. -->
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
            <CornerRadius x:Key="CornerRadiusRound">15</CornerRadius>
            <CornerRadius x:Key="CornerRadiusCard">18</CornerRadius>
            <!-- GitHub Markdown palette. LiveMarkdown resolves these resources dynamically. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D7D7D7" />
                    <SolidColorBrush x:Key="InputControlBorderBrush" Color="#B1B1B1" />
                    <Color x:Key="ForegroundColor">#1F2328</Color>
                    <Color x:Key="ThinkingHeaderForegroundColor">#6E7781</Color>
                    <Color x:Key="ThinkingContentForegroundColor">#57606A</Color>
                    <Color x:Key="BorderColor">#D7D7D7</Color>
                    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#F6F8FA</Color>
                    <Color x:Key="SettingsNavigationBackgroundColor">#EEF1F5</Color>
                    <SolidColorBrush x:Key="SettingsListDividerBrush" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#D6D6D6" />
                    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#C3C3C3" />
                    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#1F2328" />
                    <Color x:Key="CodeInlineColor">#CF222E</Color>
                    <Color x:Key="QuoteBorderColor">#D7D7D7</Color>
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ControlBorderBrush" Color="#404040" />
                    <SolidColorBrush x:Key="InputControlBorderBrush" Color="#505050" />
                    <Color x:Key="ForegroundColor">#F0F6FC</Color>
                    <Color x:Key="ThinkingHeaderForegroundColor">#A5ADBA</Color>
                    <Color x:Key="ThinkingContentForegroundColor">#8B949E</Color>
                    <Color x:Key="BorderColor">#444444</Color>
                    <Color x:Key="CardBackgroundColor">#000000</Color>
                    <Color x:Key="SecondaryCardBackgroundColor">#111111</Color>
                    <Color x:Key="SettingsNavigationBackgroundColor">#252525</Color>
                    <SolidColorBrush x:Key="SettingsListDividerBrush" Color="#323232" />
                    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#575757" />
                    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#696969" />
                    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="#797979" />
                    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#F0F6FC" />
                    <Color x:Key="CodeInlineColor">#FF7B72</Color>
                    <Color x:Key="QuoteBorderColor">#444444</Color>
                    <x:Double x:Key="FontSizeS">12</x:Double>
                    <x:Double x:Key="FontSizeM">14</x:Double>
                    <x:Double x:Key="FontSizeL">15</x:Double>
                    <x:Double x:Key="FontSizeXl">16</x:Double>
                    <x:Double x:Key="FontSize2Xl">18</x:Double>
                    <x:Double x:Key="FontSize3Xl">20</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
